## 16. Java Code — Sudoku

```java
import java.util.*;

public class SudokuSolver {

    // ─── Approach A: Simple (recheck validity each time) ─────────────
    public void solveSudoku(char[][] board) {
        solve(board, 0, 0);
    }

    private boolean solve(char[][] board, int row, int col) {
        // Base case: completed all 9 rows → solved!
        if (row == 9) return true;

        // Move to next row when current row is complete
        if (col == 9) return solve(board, row + 1, 0);

        // Skip pre-filled cells
        if (board[row][col] != '.') {
            return solve(board, row, col + 1);
        }

        // Try digits 1 through 9
        for (char d = '1'; d <= '9'; d++) {
            if (isValid(board, row, col, d)) {
                board[row][col] = d;            // Place digit

                if (solve(board, row, col + 1)) // Recurse
                    return true;                // Solution found! propagate up

                board[row][col] = '.';          // Backtrack
            }
        }

        return false; // No digit worked → trigger backtrack in caller
    }

    private boolean isValid(char[][] board, int row, int col, char d) {
        for (int i = 0; i < 9; i++) {
            // Row check
            if (board[row][i] == d) return false;

            // Column check
            if (board[i][col] == d) return false;

            // 3x3 box check
            int boxRow = (row / 3) * 3 + i / 3;
            int boxCol = (col / 3) * 3 + i % 3;
            if (board[boxRow][boxCol] == d) return false;
        }
        return true;
    }

    // ─── Approach B: Optimized with boolean arrays O(1) checks ───────
    private boolean[][] rowUsed = new boolean[9][10];
    private boolean[][] colUsed = new boolean[9][10];
    private boolean[][] boxUsed = new boolean[9][10];

    public void solveSudokuFast(char[][] board) {
        // Initialize tracking arrays from existing board
        for (int r = 0; r < 9; r++) {
            for (int c = 0; c < 9; c++) {
                if (board[r][c] != '.') {
                    int d = board[r][c] - '0';
                    int box = (r / 3) * 3 + (c / 3);
                    rowUsed[r][d] = colUsed[c][d] = boxUsed[box][d] = true;
                }
            }
        }
        solveFast(board, 0, 0);
    }

    private boolean solveFast(char[][] board, int row, int col) {
        if (row == 9) return true;
        if (col == 9) return solveFast(board, row + 1, 0);

        if (board[row][col] != '.') {
            return solveFast(board, row, col + 1);
        }

        int box = (row / 3) * 3 + (col / 3);

        for (int d = 1; d <= 9; d++) {
            // O(1) validity check
            if (!rowUsed[row][d] && !colUsed[col][d] && !boxUsed[box][d]) {
                board[row][col] = (char) ('0' + d);
                rowUsed[row][d] = colUsed[col][d] = boxUsed[box][d] = true;

                if (solveFast(board, row, col + 1)) return true;

                // Backtrack
                board[row][col] = '.';
                rowUsed[row][d] = colUsed[col][d] = boxUsed[box][d] = false;
            }
        }
        return false;
    }

    // ─── Utility ──────────────────────────────────────────────────────
    public void printBoard(char[][] board) {
        for (int r = 0; r < 9; r++) {
            if (r % 3 == 0 && r != 0) System.out.println("------+-------+------");
            for (int c = 0; c < 9; c++) {
                if (c % 3 == 0 && c != 0) System.out.print("| ");
                System.out.print(board[r][c] + " ");
            }
            System.out.println();
        }
    }

    // ─── Main ──────────────────────────────────────────────────────────
    public static void main(String[] args) {
        SudokuSolver sol = new SudokuSolver();

        char[][] board = {
            {'5','3','.','.','7','.','.','.','.'},
            {'6','.','.','1','9','5','.','.','.'},
            {'.','9','8','.','.','.','.','6','.'},
            {'8','.','.','.','6','.','.','.','3'},
            {'4','.','.','8','.','3','.','.','1'},
            {'7','.','.','.','2','.','.','.','6'},
            {'.','6','.','.','.','.','2','8','.'},
            {'.','.','.','4','1','9','.','.','5'},
            {'.','.','.','.','8','.','.','7','9'}
        };

        System.out.println("=== Sudoku Solver ===\n");
        System.out.println("Input:");
        sol.printBoard(board);

        sol.solveSudoku(board);

        System.out.println("\nSolution:");
        sol.printBoard(board);
    }
}
```

### Complexity Analysis

| | Complexity | Notes |
|--|--|--|
| **Time (worst)** | O(9^M) | M = number of empty cells |
| **Time (typical)** | Much better | Pruning eliminates most branches early |
| **Space** | O(81) = O(1) | Board is fixed size; stack depth ≤ 81 |

