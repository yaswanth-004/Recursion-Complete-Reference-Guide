## 8. Java Code — N-Queens

```java
import java.util.*;

public class NQueens {

    // ─── Approach A: HashSets (readable) ───────────────────────────
    public List<List<String>> solveNQueens(int n) {
        List<List<String>> result = new ArrayList<>();
        char[][] board = new char[n][n];
        for (char[] row : board) Arrays.fill(row, '.');

        Set<Integer> cols  = new HashSet<>();
        Set<Integer> diag1 = new HashSet<>(); // r - c
        Set<Integer> diag2 = new HashSet<>(); // r + c

        solve(board, 0, n, cols, diag1, diag2, result);
        return result;
    }

    private void solve(char[][] board, int row, int n,
                       Set<Integer> cols, Set<Integer> diag1, Set<Integer> diag2,
                       List<List<String>> result) {
        // Base case: all N queens placed
        if (row == n) {
            result.add(boardToList(board));
            return;
        }

        for (int col = 0; col < n; col++) {
            // Check all three conflict conditions
            if (cols.contains(col) ||
                diag1.contains(row - col) ||
                diag2.contains(row + col)) continue;

            // Place queen
            board[row][col] = 'Q';
            cols.add(col);
            diag1.add(row - col);
            diag2.add(row + col);

            // Recurse to next row
            solve(board, row + 1, n, cols, diag1, diag2, result);

            // Backtrack: remove queen
            board[row][col] = '.';
            cols.remove(col);
            diag1.remove(row - col);
            diag2.remove(row + col);
        }
    }

    private List<String> boardToList(char[][] board) {
        List<String> list = new ArrayList<>();
        for (char[] row : board) list.add(new String(row));
        return list;
    }

    // ─── Approach B: Bitmask (fastest, O(1) operations) ─────────────
    private int n;
    private List<List<String>> solutions;

    public List<List<String>> solveNQueensBitmask(int n) {
        this.n = n;
        this.solutions = new ArrayList<>();
        int[] queens = new int[n]; // queens[row] = column of queen in that row
        Arrays.fill(queens, -1);
        solveBitmask(queens, 0, 0, 0, 0);
        return solutions;
    }

    private void solveBitmask(int[] queens, int row,
                               int colMask, int diag1Mask, int diag2Mask) {
        if (row == n) {
            solutions.add(queensToBoard(queens));
            return;
        }

        // availablePositions: bits that are not attacked
        int available = ((1 << n) - 1) & ~(colMask | diag1Mask | diag2Mask);

        while (available != 0) {
            int pos = available & (-available);  // lowest set bit
            available &= available - 1;          // clear lowest set bit
            int col = Integer.numberOfTrailingZeros(pos);

            queens[row] = col;
            solveBitmask(queens, row + 1,
                         colMask  | pos,
                         (diag1Mask | pos) << 1,
                         (diag2Mask | pos) >> 1);
            queens[row] = -1;
        }
    }

    private List<String> queensToBoard(int[] queens) {
        List<String> board = new ArrayList<>();
        for (int q : queens) {
            char[] row = new char[n];
            Arrays.fill(row, '.');
            row[q] = 'Q';
            board.add(new String(row));
        }
        return board;
    }

    // Count solutions only (memory-efficient)
    public int totalNQueens(int n) {
        return countSolutions(0, 0, 0, 0, n);
    }

    private int countSolutions(int row, int colMask, int diag1Mask, int diag2Mask, int n) {
        if (row == n) return 1;
        int count = 0;
        int available = ((1 << n) - 1) & ~(colMask | diag1Mask | diag2Mask);
        while (available != 0) {
            int pos = available & (-available);
            available &= available - 1;
            count += countSolutions(row + 1,
                                    colMask  | pos,
                                    (diag1Mask | pos) << 1,
                                    (diag2Mask | pos) >> 1,
                                    n);
        }
        return count;
    }

    // ─── Main ──────────────────────────────────────────────────────
    public static void main(String[] args) {
        NQueens sol = new NQueens();

        System.out.println("=== N-Queens (N=4) ===");
        List<List<String>> solutions = sol.solveNQueens(4);
        System.out.println("Total solutions: " + solutions.size());
        for (List<String> board : solutions) {
            for (String row : board) System.out.println(row);
            System.out.println();
        }

        System.out.println("=== Solution Count for each N ===");
        for (int i = 1; i <= 10; i++) {
            System.out.printf("N=%2d → %d solutions%n", i, sol.totalNQueens(i));
        }
    }
}
```

